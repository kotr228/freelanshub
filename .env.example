# ============================================
# FreelanceHub - Конфігурація для PHPMyAdmin
# ============================================

# Сервер
PORT=5000
NODE_ENV=development

# ============ PHPMYADMIN / MYSQL ============
# Хост (зазвичай localhost для XAMPP/WAMP)
DB_HOST=localhost

# Порт MySQL
DB_PORT=3306

# Ім'я бази даних (створіть в PHPMyAdmin)
DB_NAME=freelancehub

# Користувач (зазвичай root для локального)
DB_USER=root

# Пароль (якщо немає - залиште порожнім)
DB_PASSWORD=

# ============================================

# JWT налаштування
JWT_SECRET=freelancehub-secret-key-change-this-123456
JWT_EXPIRE=7d

# Frontend URL
CLIENT_URL=http://localhost:3000

# Email (опціонально)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply@freelancehub.com
