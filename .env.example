# MySQL / MariaDB connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=freelanshub
DB_PASSWORD=change-me
DB_NAME=freelans

# Secret for signing session cookies (min 32 chars). Generate: openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Where uploaded files are stored (outside public/, served with access checks)
STORAGE_DIR=./storage

# Protects GET /api/cron/cleanup (call it once a day from cron)
CRON_SECRET=replace-me
